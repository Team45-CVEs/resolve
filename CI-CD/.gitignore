# Local test environment (make setup)
.venv/

# Local API keys and environment variables: copy .env.example to .env. Never commit .env.
.env

# Test output (make test)
test-results/

# Python and pytest caches
__pycache__/
.pytest_cache/

# Keep the sample projects' build output, even if a parent .gitignore ignores dist/
!tests/sample-projects/**/dist/