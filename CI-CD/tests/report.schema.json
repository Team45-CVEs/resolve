{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report.schema.json",
  "title": "RESOLVE action report",
  "description": "Required structure of every report a target script writes. Starter version: 'metadata' matches ci_env.metadata() exactly; extend 'properties' and 'required' with each report's own fields as the scripts are written.",
  "type": "object",
  "required": ["metadata"],
  "properties": {
    "metadata": {
      "description": "Where and how the report was made: the dict returned by ci_env.metadata().",
      "type": "object",
      "required": [
        "platform", "workspace", "commit_sha", "ref_name", "repository",
        "run_id", "run_number", "job_name", "event", "actor", "server_url"
      ],
      "additionalProperties": false,
      "properties": {
        "platform":   { "enum": ["github", "gitlab", "local"] },
        "workspace":  { "type": ["string", "null"] },
        "commit_sha": { "type": ["string", "null"] },
        "ref_name":   { "type": ["string", "null"] },
        "repository": { "type": ["string", "null"] },
        "run_id":     { "type": ["string", "null"] },
        "run_number": { "type": ["string", "null"] },
        "job_name":   { "type": ["string", "null"] },
        "event":      { "type": ["string", "null"] },
        "actor":      { "type": ["string", "null"] },
        "server_url": { "type": ["string", "null"] }
      }
    },
    "findings": {
      "description": "Number of findings the tool reported.",
      "type": "integer",
      "minimum": 0
    }
  }
}
